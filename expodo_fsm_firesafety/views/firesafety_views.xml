<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form: Equipment, Inspection and testing, Condition checks -->
    <record id="view_fsm_order_form_firesafety" model="ir.ui.view">
        <field name="name">expodo.fsm.order.form.firesafety</field>
        <field name="model">expodo.fsm.order</field>
        <field name="inherit_id" ref="expodo_fieldservice.view_fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Equipment" name="equipment">
                    <group>
                        <field name="equipment_type"/>
                        <field name="agent_type" invisible="equipment_type != 'extinguisher'"/>
                        <field name="device_brand"/>
                        <field name="device_model"/>
                        <field name="serial_number"/>
                    </group>
                    <group>
                        <field name="building"/>
                        <field name="device_location"/>
                        <field name="capacity"/>
                        <field name="install_date"/>
                    </group>
                </group>
                <group string="Inspection &amp; Testing" name="inspection">
                    <group>
                        <field name="last_inspection_date"/>
                        <field name="next_inspection_date"/>
                        <field name="inspection_body"/>
                        <field name="compliance_ref"/>
                    </group>
                    <group>
                        <field name="last_pressure_test"/>
                        <field name="next_pressure_test"/>
                    </group>
                </group>
                <group string="Condition Checks" name="condition">
                    <group>
                        <field name="pressure_gauge_ok"/>
                        <field name="seal_intact"/>
                        <field name="safety_pin_ok"/>
                    </group>
                    <group>
                        <field name="hose_nozzle_ok"/>
                        <field name="access_clear"/>
                        <field name="signage_ok"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- List: add device and next inspection columns -->
    <record id="view_fsm_order_list_firesafety" model="ir.ui.view">
        <field name="name">expodo.fsm.order.list.firesafety</field>
        <field name="model">expodo.fsm.order</field>
        <field name="inherit_id" ref="expodo_fieldservice.view_fsm_order_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="device_brand" optional="show"/>
                <field name="next_inspection_date" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban: show brand and type on the card -->
    <record id="view_fsm_order_kanban_firesafety" model="ir.ui.view">
        <field name="name">expodo.fsm.order.kanban.firesafety</field>
        <field name="model">expodo.fsm.order</field>
        <field name="inherit_id" ref="expodo_fieldservice.view_fsm_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fsm_type_id']" position="after">
                <div t-if="record.device_brand.raw_value" class="mt-1">
                    <span class="badge text-bg-secondary"><field name="device_brand"/></span>
                    <span t-if="record.equipment_type.raw_value" class="badge text-bg-danger ms-1">
                        <field name="equipment_type"/>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Fire Safety app menu -->
    <menuitem id="menu_root_firesafety" name="Fire Safety Field Service" sequence="46"
              groups="expodo_fieldservice.group_fsm_technician"/>
    <menuitem id="menu_firesafety_orders" name="Service Orders"
              parent="menu_root_firesafety" action="expodo_fieldservice.action_fsm_order" sequence="10"/>
    <menuitem id="menu_firesafety_config" name="Configuration"
              parent="menu_root_firesafety" sequence="90"
              groups="expodo_fieldservice.group_fsm_manager"/>
    <menuitem id="menu_firesafety_types" name="Intervention Types"
              parent="menu_firesafety_config" action="expodo_fieldservice.action_fsm_type" sequence="10"/>
    <menuitem id="menu_firesafety_stages" name="Stages"
              parent="menu_firesafety_config" action="expodo_fieldservice.action_fsm_stage" sequence="20"/>

</odoo>
